  "realm": "spi-examples",
  "enabled": true,
  "passwordPolicy": "length(8) and noIdentityInPassword",
  "users": [
    {
      "username": "flagged-user",
      "enabled": true,
      "email": "flagged-user@example.com",
      "firstName": "Flagged",
      "lastName": "User",
      "emailVerified": true,
      "attributes": {
        "requiresReview": ["true"]
      },
      "credentials": [
